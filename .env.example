# Copie para .env e preencha. NUNCA versione o .env (já está no .gitignore).
# Nenhum valor abaixo é um segredo real: são marcadores.

# ---- Banco de dados (MySQL 8.x) ----
BANCO_NOME=painel_ccet_ibio
BANCO_USUARIO=painel_app
# Gere senhas fortes, por exemplo:  openssl rand -base64 24
BANCO_SENHA=
BANCO_SENHA_ROOT=

# ---- API (Spring Boot) ----
# Cookie de sessão só trafega em HTTPS quando true. Use true em produção (atrás de HTTPS).
COOKIE_SEGURO=false
# Origens extras permitidas por CORS (separadas por vírgula). Vazio = nenhuma (o nginx faz proxy na mesma origem).
CORS_ORIGENS=

# Conta de coordenação criada na PRIMEIRA subida, somente se ainda não existir nenhum usuário.
# A senha precisa ter 10+ caracteres com letras e números. Troque-a depois pelo botão "senha" do painel
# e remova ADMIN_SENHA do .env.
ADMIN_LOGIN=
ADMIN_NOME=Coordenação
ADMIN_SENHA=

# ---- Portas ----
# Local (mvnw spring-boot:run + npm run dev, MySQL instalado na máquina):
#   API 8080 · Swagger 8081 (http://localhost:8081/actuator/swagger-ui) · front 5173 · MySQL 127.0.0.1:3306
BANCO_PORTA=3306
PORTA_API=8080
PORTA_DOCS=8081
# Docker (docker compose up): front 8083 · API 127.0.0.1:8082 · MySQL 127.0.0.1:3307
PORTA_WEB=8083
PORTA_API_DOCKER=8082
BANCO_PORTA_HOST=3307

# ---- Documentação OpenAPI (Swagger) ----
# DOCS_API vale para a execução local; DOCS_API_DOCKER para o container. Deixe false em produção.
DOCS_API=true
DOCS_API_DOCKER=false

# ---- Painel (dashboard externo) ----
# Link do relatório exibido na aba "Painel" (ex.: Google Looker Studio). Vazio = não configurado.
# Lido pelo front em tempo de execução (npm run dev e Docker); basta reiniciar o front após mudar.
PAINEL_DASHBOARD_URL=

# ---- Testes E2E (opcional; Playwright, contra a pilha no ar) ----
# Use contas de TESTE criadas por você na tela de usuários; nunca contas reais de produção.
# E2E_BASE_URL=http://localhost:8083
# E2E_PROF_LOGIN=
# E2E_PROF_SENHA=
# E2E_ALUNO_LOGIN=
# E2E_ALUNO_SENHA=

# Copie para ".env" e ajuste antes de subir o ambiente de homologação.
# Nunca commite o arquivo ".env" real.

MYSQL_PASSWORD=bussola
MYSQL_ROOT_PASSWORD=bussola_root

# Gere um valor forte e aleatório para produção/homologação real, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-homologacao-please-override-this-value
JWT_EXPIRATION_SECONDS=28800

# Origem(ns) autorizadas a chamar a API (o frontend servido pelo nginx)
CORS_ALLOWED_ORIGINS=http://localhost:4201

SPRING_PROFILES_ACTIVE=dev

# PRODUÇÃO — copie para .env.producao NO SERVIDOR e preencha. Nunca versione o .env.producao.
#   cp .env.producao.example .env.producao && chmod 600 .env.producao
# Gere senhas fortes com:  scripts/gerar-senha.sh   (use senhas DIFERENTES das de desenvolvimento)

# ---- Domínio e HTTPS (Caddy) ----
# Domínio (ou subdomínio) cujo DNS aponta para o IP público do servidor. Ex.: painel.seudominio.com.br
DOMINIO=
# E-mail para avisos do Let's Encrypt (expiração/problemas de certificado).
ACME_EMAIL=

# ---- Banco de dados (MySQL 8.4, só na rede interna do Docker) ----
BANCO_NOME=painel_ccet_ibio
BANCO_USUARIO=painel_app
BANCO_SENHA=
BANCO_SENHA_ROOT=

# ---- Conta inicial (criada só se o banco não tiver usuários) ----
# Após o primeiro login: troque a senha pelo painel e APAGUE o valor de ADMIN_SENHA deste arquivo.
ADMIN_LOGIN=
ADMIN_NOME=Coordenação
ADMIN_SENHA=

# ---- Front ----
# Link do dashboard externo da aba "Painel" (ex.: Google Looker Studio). Vazio = não configurado.
PAINEL_DASHBOARD_URL=

# ---- JVM (opcional) ----
# Limite de memória da API em % da RAM do container/servidor.
JAVA_OPCOES=-XX:MaxRAMPercentage=70
